VITE_MAPBOX_TOKEN="your_mapbox_access_token"
RESEND_API_KEY="your_resend_api_key_here"

# Anthropic API key for the "Ask Josh" assistant (/api/ask). Leave empty and Ask Claude answers from the portfolio data in the browser.
ANTHROPIC_API_KEY=""

# Real Google results in the Chrome app (/api/search). Create a "search the entire web" engine at
# https://programmablesearchengine.google.com (the cx id) and an API key at
# https://console.cloud.google.com/apis/credentials with the Custom Search API enabled.
# Leave empty and search falls back to DuckDuckGo (which sometimes refuses server requests).
GOOGLE_SEARCH_KEY=""
GOOGLE_SEARCH_CX=""
