VITE_MAPBOX_TOKEN="your_mapbox_access_token"
RESEND_API_KEY="your_resend_api_key_here"

# Anthropic API key for the "Ask Josh" assistant (/api/ask). Leave empty to show the app as unconfigured.
ANTHROPIC_API_KEY=""

# Local Docker Postgres for API-backed features such as the Snake leaderboard.
DATABASE_URL="postgres://portfolio:portfolio@localhost:5433/portfolio"
