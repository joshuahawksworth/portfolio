VITE_MAPBOX_TOKEN="your_mapbox_access_token"
RESEND_API_KEY="your_resend_api_key_here"

# Anthropic API key for the "Ask Josh" assistant (/api/ask). Leave empty and Ask Claude answers from the portfolio data in the browser.
ANTHROPIC_API_KEY=""

# Web search in the Chrome app (/api/search). Set one of these:
#   BRAVE_SEARCH_KEY  https://brave.com/search/api  (own index; monthly free credit, card required)
#   TAVILY_API_KEY    https://tavily.com             (free tier, no card)
# Google Programmable Search no longer lets new engines search the whole web (since 20 Jan 2026);
# GOOGLE_SEARCH_KEY / GOOGLE_SEARCH_CX only work with an engine created before then.
# With no key, search tries Bing's results page and DuckDuckGo, which refuse most hosting providers.
BRAVE_SEARCH_KEY=""
TAVILY_API_KEY=""
GOOGLE_SEARCH_KEY=""
GOOGLE_SEARCH_CX=""
